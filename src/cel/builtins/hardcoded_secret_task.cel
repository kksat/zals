zals.Rule{
  id: "hardcoded-secret[task]",
  target: "task",
  severity: "error",
  condition: node.string_leaves.exists(l,
    l.key.matches("(^|_)([pP][aA][sS][sS][wW][oO][rR][dD]|[pP][aA][sS][sS][wW][dD]|[pP][wW][dD]|[pP][aA][sS][sS][pP][hH][rR][aA][sS][eE]|[sS][eE][cC][rR][eE][tT][sS]?|[tT][oO][kK][eE][nN][sS]?|[aA][pP][iI]_?[kK][eE][yY]|[pP][rR][iI][vV][aA][tT][eE]_?[kK][eE][yY])($|_)") &&
    l.value != l.key &&
    !l.is_templated),
  message: "Hardcoded secret detected in '" +
    node.string_leaves.filter(l,
      l.key.matches("(^|_)([pP][aA][sS][sS][wW][oO][rR][dD]|[pP][aA][sS][sS][wW][dD]|[pP][wW][dD]|[pP][aA][sS][sS][pP][hH][rR][aA][sS][eE]|[sS][eE][cC][rR][eE][tT][sS]?|[tT][oO][kK][eE][nN][sS]?|[aA][pP][iI]_?[kK][eE][yY]|[pP][rR][iI][vV][aA][tT][eE]_?[kK][eE][yY])($|_)") &&
      l.value != l.key &&
      !l.is_templated)[0].key +
    "'; use a variable or Ansible Vault instead."
}
