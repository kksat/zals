zals.Rule{
  id: "argument-specs[secret-no-log]",
  target: "argument_spec",
  severity: "info",
  condition: node.is_map &&
    node.name.matches(".*(^|_)(password|passphrase|token|secret|key)$") &&
    !(node.no_log != null && node.no_log.kind == "bool" && node.no_log.value),
  message: "Variable '" + node.path + "' looks like a secret but does not set " +
    "'no_log: true' in argument_specs.yml; its values may appear in logs " +
    "(may be intentional)."
}
