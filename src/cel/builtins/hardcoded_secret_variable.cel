zals.Rule{
  id: "hardcoded-secret[variable]",
  target: "var_def",
  severity: "error",
  field: "name",
  condition: node.site in ["vars_file", "role_defaults", "play_vars", "role_vars"] &&
    node.name.matches("(^|_)([pP][aA][sS][sS][wW][oO][rR][dD]|[pP][aA][sS][sS][wW][dD]|[pP][wW][dD]|[pP][aA][sS][sS][pP][hH][rR][aA][sS][eE]|[sS][eE][cC][rR][eE][tT][sS]?|[tT][oO][kK][eE][nN][sS]?|[aA][pP][iI]_?[kK][eE][yY]|[pP][rR][iI][vV][aA][tT][eE]_?[kK][eE][yY])($|_)") &&
    node.value != null &&
    !node.value.is_templated &&
    node.value.kind in ["string", "int", "float"] &&
    !(node.value.kind == "string" && node.value.value == ""),
  message: "Hardcoded secret detected in variable '" + node.name + "'; use Ansible Vault instead."
}
