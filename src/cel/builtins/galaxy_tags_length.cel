zals.Rule{
  id: "galaxy[tags-length]",
  target: "galaxy_meta",
  severity: "warning",
  field: "tags",
  condition: node.has_tags &&
    node.tags != null &&
    node.tags.kind == "list" &&
    node.tags.value.exists(t, type(t) == string && (size(t) < 2 || size(t) > 64)),
  message: "galaxy.yml tags must be between 2 and 64 characters long."
}
