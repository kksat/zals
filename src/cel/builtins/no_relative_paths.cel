zals.Rule{
  id: "no-relative-paths",
  target: "task",
  severity: "warning",
  field: "src",
  condition: node.short_action in ["template", "win_template", "copy", "win_copy", "script", "assemble"] &&
    "src" in node.args &&
    node.args.src.kind == "string" &&
    !node.args.src.is_templated &&
    (node.args.src.value.startsWith("..") || node.args.src.value.contains("../")),
  message: "Do not use relative parent paths ('..') in module 'src'."
}
