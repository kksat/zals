zals.Rule{
  id: "no-log-password",
  target: "task",
  severity: "error",
  field: "action",
  condition: !(node.has_no_log && node.no_log != null &&
      ((node.no_log.kind == "bool" && node.no_log.value) || node.no_log.is_templated)) &&
    node.arg_keys.exists(k,
      k.matches("(^|_)password($|_)") &&
      node.args[k].kind != "null" &&
      !(node.args[k].kind == "string" && node.args[k].value == "")
    ),
  message: "When passing a password parameter, set 'no_log: true' on the task."
}
