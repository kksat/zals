zals.Rule{
  id: "galaxy[tags-format]",
  target: "galaxy_meta",
  severity: "warning",
  field: "tags",
  condition: node.has_tags &&
    node.tags != null &&
    node.tags.kind == "list" &&
    node.tags.value.exists(t, type(t) != string || !t.matches("^[a-z0-9_]+$")),
  message: "galaxy.yml tags must match '^[a-z0-9_]+$'."
}
