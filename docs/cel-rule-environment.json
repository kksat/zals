      "node_fields": {
        "keys": "list<string>",
        "invocation_form": "enum(module_key,action,local_action,block)",
        "is_block": "bool",
        "raw_action": "string",
        "raw_action_key": "string",
        "action": "string",
        "short_action": "string",
        "action_namespace": "string",
        "is_free_form": "bool",
        "free_form_text": "string",
        "module_val_kind": "string",
        "has_args_key": "bool",
        "args_val_kind": "string",
        "args": "map<string, TypedValue>",
        "arg_keys": "list<string>",
        "command": "map",
        "has_name": "bool",
        "name": "TypedValue | null",
        "name_text": "string",
        "is_duplicate_name": "bool",
        "when": "list<TypedValue>",
        "changed_when": "list<TypedValue>",
        "failed_when": "list<TypedValue>",
        "until": "list<TypedValue>",
        "has_changed_when": "bool",
        "has_failed_when": "bool",
        "has_ignore_errors": "bool",
        "ignore_errors": "TypedValue | null",
        "has_register": "bool",
        "register": "TypedValue | null",
        "has_no_log": "bool",
        "no_log": "TypedValue | null",
        "has_become": "bool",
        "has_become_user": "bool",
        "has_delegate_to": "bool",
        "delegate_to": "TypedValue | null",
        "has_run_once": "bool",
        "run_once": "TypedValue | null",
        "has_async": "bool",
        "async": "TypedValue | null",
        "has_poll": "bool",
        "poll": "TypedValue | null",
        "has_local_action": "bool",
        "loop_key": "string",
        "loop": "TypedValue | null",
        "in_handlers": "bool",
        "in_block": "bool",
        "nesting_depth": "int",
        "section": "string",
        "play_strategy": "string",
        "play_name": "string",
        "string_leaves": "list<map>"
      }
    },
    "role_ref": {
      "fields": ["self", "name", "role", "when"],
      "node_fields": {
