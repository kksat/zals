      }
    },
    "var_def": {
      "fields": ["self", "name", "value"],
      "node_fields": {
        "name": "string",
        "key_kind": "string",
        "is_quoted": "bool",
        "is_templated": "bool",
        "is_ascii": "bool",
        "site": "string",
        "value": "TypedValue | null"
      }
    },
    "role_meta": {
      "fields": ["self", "author", "description", "company", "license", "min_ansible_version", "galaxy_tags", "categories", "platforms", "video_links"],
      "node_fields": {
        "has_galaxy_info": "bool",
