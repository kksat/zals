{
  "$schema": "https://zals.dev/schemas/cel-rule-environment/v1",
  "schema_version": 1,
  "engine": {
    "name": "zig-cel",
    "commit": "445a967",
    "profile": "standard-cel-no-proto",
    "macros": ["has", "all", "exists", "exists_one", "filter", "map"],
    "functions": [
      "size",
      "contains",
      "startsWith",
      "endsWith",
      "matches",
      "int",
      "uint",
      "double",
      "string",
      "bool",
      "bytes",
      "type",
      "dyn",
      "duration",
      "timestamp"
    ],
    "limits": {
      "max_rule_source_bytes": 65536,
      "max_ast_nodes": 2048,
      "max_ast_depth": 64,
      "max_comprehension_depth": 4,
      "max_regex_pattern_bytes": 512,
      "max_diagnostics_per_document": 512,
      "max_diagnostics_per_rule_per_document": 128,
      "max_message_bytes": 2048,
      "max_run_steps": 1000000
    }
  },
  "declaration": {
    "type": "zals.Rule",
    "fields": {
      "id": { "type": "string", "literal": true, "required": true },
      "target": { "type": "string | list<string>", "literal": true, "required": true },
      "severity": { "type": "enum(error,warning,info,hint)", "literal": true, "required": true },
      "field": { "type": "string", "literal": true, "required": false },
      "schema_version": { "type": "int", "literal": true, "required": false, "default": 1 },
      "condition": { "type": "expr<bool>", "required": true },
      "message": { "type": "expr<string>", "required": true }
    }
  },
  "bindings": {
    "location": {
      "type": "map",
      "fields": {
        "path": "string",
        "line": "int",
        "column": "int"
      }
    },
    "document": {
      "type": "map",
      "fields": {
        "path": "string",
        "filename": "string",
        "extension": "string",
        "kind": "string",
        "play_count": "int",
        "task_count": "int",
        "parse_issue_count": "int",
        "has_argument_specs": "bool"
      }
    },
    "context": {
      "type": "map",
      "fields": {
        "role": {
          "type": "map",
          "fields": {
            "present": "bool",
            "name": "string",
            "path": "string",
            "entry_point": "string",
            "has_argument_specs_file": "bool",
            "has_argument_specs": "bool",
            "has_meta": "bool",
            "has_defaults": "bool",
            "has_tasks": "bool",
            "has_handlers": "bool",
            "argument_specs": "map<string, map>",
            "defaults": "map<string, map>"
          }
        },
        "collection": {
          "type": "map",
          "fields": {
            "present": "bool",
            "namespace": "string",
            "name": "string",
            "fqcn": "string",
            "path": "string",
            "has_meta_runtime": "bool",
            "has_changelog": "bool"
          }
        },
        "play": {
          "type": "map",
          "fields": {
            "present": "bool",
            "index": "int",
            "name": "string",
            "hosts": "string",
            "strategy": "string",
            "has_become": "bool",
            "has_become_user": "bool",
            "collections": "list<string>",
            "handler_names": "list<string>",
            "var_names": "list<string>"
          }
        },
        "block": {
          "type": "map",
          "fields": {
            "present": "bool",
            "nesting_depth": "int",
            "section": "string",
            "has_become": "bool",
            "has_become_user": "bool",
            "has_no_log": "bool",
            "has_ignore_errors": "bool",
            "when": "list<TypedValue>"
          }
        }
      }
    },
    "metadata": {
      "type": "map",
      "fields": {
        "available": "bool",
        "status": "enum(ready,pending,unavailable,partial,stale)",
        "environment_id": "string",
        "reason": "string",
        "modules": "map<string, map>"
      }
    },
    "options": { "type": "map<string, dyn>" }
  },
  "typed_value_shape": {
    "kind": "enum(null,bool,int,float,string,template,list,map)",
    "is_templated": "bool",
    "is_quoted": "bool",
    "raw": "string",
    "value": "dyn"
  },
  "targets": {
    "document": {
      "fields": ["root"],
      "node_fields": {
        "path": "string",
        "filename": "string",
        "extension": "string",
        "kind": "string",
        "play_count": "int",
        "task_count": "int",
        "parse_issue_count": "int",
        "has_argument_specs": "bool"
      }
    },
    "play": {
      "fields": ["self", "name", "hosts", "become", "become_user", "strategy", "run_once", "vars_prompt", "collections", "tasks", "pre_tasks", "post_tasks", "handlers", "roles", "import_playbook"],
      "node_fields": {
        "index": "int",
        "keys": "list<string>",
        "has_name": "bool",
        "name": "TypedValue | null",
        "name_text": "string",
        "hosts": "TypedValue | null",
        "strategy": "TypedValue | null",
        "strategy_text": "string",
        "has_become": "bool",
        "has_become_user": "bool",
        "has_vars_prompt": "bool",
        "has_run_once": "bool",
