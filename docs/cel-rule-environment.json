        "description": "TypedValue | null",
        "company": "TypedValue | null",
        "license": "TypedValue | null",
        "min_ansible_version": "TypedValue | null",
        "has_galaxy_tags": "bool",
        "galaxy_tags": "TypedValue | null",
        "has_categories": "bool",
        "categories": "TypedValue | null",
        "has_platforms": "bool",
        "platforms": "TypedValue | null",
        "video_links": "list<map>"
      }
    },
    "galaxy_meta": {
      "fields": ["self", "namespace", "name", "version", "tags", "dependencies", "repository", "license", "license_file"],
      "node_fields": {
        "namespace": "TypedValue | null",
        "name": "TypedValue | null",
        "has_version": "bool",
        "version": "TypedValue | null",
        "has_tags": "bool",
        "tags": "TypedValue | null",
        "dependencies": "list<map>",
        "has_repository": "bool",
        "repository": "TypedValue | null",
        "has_license": "bool",
        "license": "TypedValue | null",
        "has_license_file": "bool",
        "license_file": "TypedValue | null"
      }
    },
    "argument_spec_entry": {
      "fields": ["self", "author", "attributes", "deprecated", "description", "examples", "notes", "options", "requirements", "seealso", "short_description", "todo", "version_added"],
      "node_fields": {
        "name": "string",
        "is_map": "bool",
        "keys": "list<string>",
